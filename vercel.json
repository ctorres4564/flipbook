{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/$",
      "has": [
        {
          "type": "host",
          "value": "theo.folheia.com"
        }
      ],
      "dest": "/livros/theo/index.html"
    },
    {
      "src": "/$",
      "has": [
        {
          "type": "host",
          "value": "nico.folheia.com"
        }
      ],
      "dest": "/livros/nico/index.html"
    },
    {
      "src": "/livros/theo/?$",
      "dest": "/livros/theo/index.html"
    },
    {
      "src": "/livros/nico/?$",
      "dest": "/livros/nico/index.html"
    },
    {
      "src": "/livros/caminhos-de-nina/?$",
      "dest": "/livros/caminhos-de-nina/index.html"
    },
    {
      "src": "/livros/cartilha-engasgo/?$",
      "dest": "/livros/cartilha-engasgo/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
